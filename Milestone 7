def save_students(students, filename):

f = open(filename, "w")
  for s in students:
grades = ";".join(str(g) for g in s.get_grades())

    if isinstance(s, UndergraduateStudent):

    line = "Undergraduate," + s.name + "," + s.student_id + "," + s.major + "," + grades

       else:

    line = "Graduate," + s.name + "," + s.student_id + "," + s.program_title + "," + grades

f.write(line + "")
f.close()

def read_students(filename):
students = []
    try:
 f = open(filename, "r")
 for line in f:
    data = line.strip().split(",")
        if data[0] == "Undergraduate":

s = UndergraduateStudent(data[1], data[2], data[3])
    else:

s = GraduateStudent(data[1], data[2], data[3])

for g in data[4].split(";"):
s.add_grades(float(g))
students.append(s)
f.close()

except FileNotFoundError:
print("File not found")
return students

